{
  "name": "mailwarden",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.9.2",
  "description": "Sender-level Gmail cleanup with consent-gated, fully reversible batch actions.",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "typecheck": "npm run typecheck --workspace=server",
    "logs": "node scripts/logs.mjs",
    "logs:tail": "node scripts/logs.mjs --tail",
    "deploy": "flyctl deploy --app mailwarden --remote-only",
    "status": "flyctl status --app mailwarden",
    "e2e": "node scripts/e2e.mjs",
    "queue": "node scripts/queue.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
