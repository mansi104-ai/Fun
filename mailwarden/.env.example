# ─── Core ────────────────────────────────────────────────────────────────
PORT=8080
APP_URL=http://localhost:8080
NODE_ENV=development

# 32-byte hex key used to encrypt Gmail refresh tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production this MUST come from a KMS/secret manager, never a .env file.
TOKEN_ENCRYPTION_KEY=

# Signing key for session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Google OAuth ────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI must be exactly: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── LLM routing ─────────────────────────────────────────────────────────
# FREE tier -> OpenRouter. Hard budget: 50 requests/day on a no-credit account.
# This is why classification is per-SENDER-BATCH, never per-email.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DAILY_REQUEST_BUDGET=50

# PAID tier -> Anthropic.
#   claude-sonnet-5   $3/$15 per Mtok  (intro $2/$10 through 2026-08-31)  <- default
#   claude-haiku-4-5  $1/$5  per Mtok  <- cheapest; good enough for this task
# Batch API halves either price; see classify/llm.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=

# ─── Demo mode ───────────────────────────────────────────────────────────
# Set to 1 to expose /auth/demo, which seeds a synthetic inbox and signs you in
# WITHOUT any credential check. Useful for evaluating the UI before Google
# approval, and for recording the OAuth verification demo video.
# Ignored entirely when NODE_ENV=production — two independent gates, because one
# misconfigured variable should not be able to expose a passwordless login.
ENABLE_DEMO=

# ─── Storage ─────────────────────────────────────────────────────────────
# SQLite for local dev. Swap for Postgres before the public launch — see
# docs/05-deployment-runbook.md.
DATABASE_PATH=./mailwarden.db
